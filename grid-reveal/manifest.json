{
  "id": "co.twostep.gridreveal",
  "name": "Grid Reveal",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "id": "gridrevealpanel",
      "type": "panel",
      "minimumSize": { "width": 300, "height": 420 },
      "maximumSize": { "width": 600, "height": 900 },
      "preferredDockedSize": { "width": 320, "height": 460 },
      "preferredFloatingSize": { "width": 340, "height": 480 },
      "label": {
        "default": "Grid Reveal"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
